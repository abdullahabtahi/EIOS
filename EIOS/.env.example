# ==============================================================================
# EIOS - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
# cp .env.example .env

# Google Cloud Platform configuration
GOOGLE_CLOUD_PROJECT=eios-platform-dev
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini LLM Gateway configuration
# EIOS_GEMINI_MODEL unset on purpose: the assistant uses the registry default (assistant_models.yaml)
EIOS_OFFLINE_REPLAY=0

# PubSub & Event Ingestion (dev defaults)
EIOS_PUBSUB_PROJECT_ID=eios-platform-dev
EIOS_PUBSUB_TOPIC_ID=eios.l1.events.v1
EIOS_PUBSUB_SUBSCRIPTION_ID=eios-l1-events-sub
EIOS_DLQ_TOPIC_ID=eios.l1.dlq.v1

# State & Storage
EIOS_DUCKDB_PATH=:memory:eios_hot_state
EIOS_LAKEHOUSE_ROOT=data/raw

# Security & Webhook verification (use secure random values in non-dev envs)
EIOS_HMAC_SALT=eios-default-dev-salt-2026
EIOS_CASHIER_WEBHOOK_SECRET=eios-cashier-sentinel-secret-v1

# Observability (Optional)
# LANGCHAIN_API_KEY=your_langchain_key_here

# Local trace viewer (dev only, see docs/local-tracing.md); content on spans only with otlp in dev/test
# EIOS_TRACE_EXPORT=otlp
# EIOS_TRACE_CAPTURE_CONTENT=1
