control_project_id = "REPLACE_ME_control_project_id"
environment_project_ids = {
  dev       = "REPLACE_ME_dev_project_id"
  stage     = "REPLACE_ME_stage_project_id"
  prod-like = "REPLACE_ME_prod_like_project_id"
}

ci_repository = "REPLACE_ME_owner/REPLACE_ME_repository"
