# Copy to terraform.tfvars (git-ignored, never committed) and replace every value.
# All values below are placeholders, not real identifiers.
region             = "REPLACE_ME_region"
billing_account_id = "REPLACE_ME_billing_account_id"

# Set exactly one of these two.
parent_org_id = "REPLACE_ME_numeric_org_id"
