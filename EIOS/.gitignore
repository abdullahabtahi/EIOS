# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
# The provider lock file is committed on purpose (reproducible provider selection).

# Evaluation reports are generated; keep the directory only
evals/reports/*
!evals/reports/.gitkeep
!evals/reports/*.py

# Local environment and secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
*.cert
service-account*.json
credentials.json
client_secret*.json
.testsprite/
testsprite.json
.testsprite.json
testsprite-artifacts/

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp
*.bak
*~
