# Backend API server base URL
EIOS_BACKEND_URL=http://127.0.0.1:8002
NEXT_PUBLIC_API_URL=http://127.0.0.1:8002

# TestSprite AI E2E Testing API Key (get from https://app.testsprite.com)
TESTSPRITE_API_KEY=your_testsprite_api_key_here

