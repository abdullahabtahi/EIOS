{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConversationQueryResponse",
  "description": "Production schema for audited conversational agent responses with dual-engine grounding and Four-Eyes governance.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session thread identifier persisted in Firestore."
    },
    "turn_index": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing turn sequence index."
    },
    "model_id": {
      "type": "string",
      "description": "Underlying LLM model identifier."
    },
    "active_route": {
      "type": "string",
      "enum": ["ExecutiveSynthesis", "AMLInvestigator", "PartnerRetention", "PartnerFraud", "GovernanceCompliance"],
      "description": "Specialist agent executing the turn under the supervisor."
    },
    "response_markdown": {
      "type": "string",
      "description": "Audited executive prose output with citations."
    },
    "auditor_status": {
      "type": "string",
      "enum": ["PASS", "BLOCKED"],
      "description": "Egress firewall verdict from MetricAuditorGate."
    },
    "provenance_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "citation_type": { "type": "string", "enum": ["METRIC", "ENTITY", "STATUTORY_POLICY", "PRECEDENT"] },
          "citation_id": { "type": "string" },
          "label": { "type": "string" },
          "source_engine": { "type": "string" },
          "as_of": { "type": "string" }
        },
        "required": ["citation_type", "citation_id", "label", "source_engine"]
      }
    },
    "staged_action_card": {
      "type": ["object", "null"],
      "properties": {
        "intent_id": { "type": "string" },
        "action_type": { "type": "string" },
        "target_entity_id": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string", "enum": ["STAGED_FOR_REVIEW", "PENDING"] },
        "requires_four_eyes": { "type": "boolean" },
        "kms_signature": { "type": "string" },
        "expires_at": { "type": "string" }
      }
    },
    "context_cached": {
      "type": "boolean",
      "description": "True if Vertex AI Context Caching was hit."
    },
    "turn_latency_ms": {
      "type": "number",
      "description": "Total turn round-trip latency in milliseconds."
    },
    "reflection_cycles_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Number of multi-agent reflection loops executed (capped at 3)."
    }
  },
  "required": [
    "session_id",
    "turn_index",
    "model_id",
    "active_route",
    "response_markdown",
    "auditor_status",
    "provenance_citations",
    "turn_latency_ms",
    "reflection_cycles_used"
  ]
}
