{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eios/feature-dependencies.schema.json",
  "title": "Feature Dependency Declaration",
  "description": "Machine-readable block a feature spec carries so readiness can be checked. Readiness rule: every listed spike is closed with an ADR and every listed ADR is Accepted before the feature starts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "depends_on_features", "depends_on_spikes", "depends_on_adrs"],
  "properties": {
    "feature": { "type": "string", "pattern": "^F[0-9]{2}$" },
    "depends_on_features": {
      "type": "array",
      "items": { "type": "string", "pattern": "^F[0-9]{2}$" },
      "uniqueItems": true
    },
    "depends_on_spikes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^S-[0-9]{2}$" },
      "uniqueItems": true
    },
    "depends_on_adrs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
      "uniqueItems": true
    }
  }
}
