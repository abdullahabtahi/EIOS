{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernedActionCard",
  "description": "Presentation model for staged Two-Phase Commit ActionIntentToken proposals in the action shelf.",
  "type": "object",
  "required": [
    "intent_id",
    "action_type",
    "target_entity_id",
    "severity",
    "requires_four_eyes",
    "kms_signature_verified",
    "status",
    "seconds_remaining"
  ],
  "properties": {
    "intent_id": { "type": "string" },
    "action_type": {
      "type": "string",
      "enum": [
        "HoldWithdrawal",
        "FreezeAccount",
        "ClawbackCommission",
        "SuspendPartner",
        "DeployRetentionVIPDeal",
        "AdjustPartnerTier",
        "EscalateToMLRO",
        "FileSARDraft"
      ]
    },
    "target_entity_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "requires_four_eyes": { "type": "boolean" },
    "first_approver_id": { "type": ["string", "null"] },
    "second_approver_id": { "type": ["string", "null"] },
    "kms_signature_verified": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_APPROVAL",
        "APPROVED",
        "EXECUTED",
        "ABORTED",
        "EXPIRED"
      ]
    },
    "seconds_remaining": { "type": "integer", "minimum": 0, "maximum": 900 }
  },
  "additionalProperties": false
}
