{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SARDraftResponse",
  "type": "object",
  "required": [
    "sar_id",
    "case_id",
    "client_id",
    "jurisdiction",
    "filing_type",
    "subject_info",
    "suspicious_activity_summary",
    "chronological_transactions",
    "narrative_basis",
    "statutory_provisions",
    "evidence_citations",
    "created_at",
    "is_replay_fallback"
  ],
  "properties": {
    "sar_id": { "type": "string" },
    "case_id": { "type": "string" },
    "client_id": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "filing_type": { "type": "string" },
    "subject_info": { "type": "object" },
    "suspicious_activity_summary": { "type": "string" },
    "chronological_transactions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "narrative_basis": { "type": "string" },
    "statutory_provisions": { "type": "array", "items": { "type": "string" } },
    "evidence_citations": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "is_replay_fallback": { "type": "boolean" }
  },
  "additionalProperties": false
}
