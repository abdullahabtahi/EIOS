{
  "name": "main-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "lint"
          },
          {
            "context": "types"
          },
          {
            "context": "coverage"
          },
          {
            "context": "contract"
          },
          {
            "context": "eval_smoke"
          },
          {
            "context": "red_line"
          },
          {
            "context": "vuln_scan"
          },
          {
            "context": "secret_scan"
          },
          {
            "context": "iac_plan"
          },
          {
            "context": "infra_policy"
          },
          {
            "context": "open_decision_check"
          },
          {
            "context": "label_check"
          },
          {
            "context": "adr_check"
          },
          {
            "context": "repo_checks"
          },
          {
            "context": "frontend-check"
          }
        ]
      }
    }
  ]
}
